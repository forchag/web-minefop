msgid "Nos valeurs"
msgstr "Our values"

#: templates/core/mission.html:43
msgid "Équité et égalité des chances"
msgstr "Fairness and equal opportunity"

#: templates/core/mission.html:44
msgid "Qualité et excellence de la formation"
msgstr "Quality and excellence in training"

#: templates/core/mission.html:45
msgid "Transparence et redevabilité"
msgstr "Transparency and accountability"

#: templates/core/mission.html:46
msgid "Partenariat public-privé"
msgstr "Public-private partnership"

#: templates/core/mission.html:47
msgid "Adéquation formation-emploi"
